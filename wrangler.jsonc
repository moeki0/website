{
  "name": "moeki-website",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "routes": [
    { "pattern": "moeki.org", "custom_domain": true },
    { "pattern": "www.moeki.org", "custom_domain": true }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
